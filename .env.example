# Copy to .env for local overrides. Never commit .env.
MAILROOM_HOST=127.0.0.1
MAILROOM_PORT=4600
MAILROOM_DB=data/mailroom.db
MAILROOM_WORKER=1
MAILROOM_WORKER_INTERVAL=2
MAILROOM_WARMUP_WORKER=1
MAILROOM_WARMUP_INTERVAL=5
MAILROOM_AUTO_SEED=1
# Optional override for the local credential encryption key.
# MAILROOM_SECRET_KEY=
